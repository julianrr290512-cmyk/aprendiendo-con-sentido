# =============================================================================
# Variables de SERVIDOR (backend en api/, NUNCA con prefijo VITE_): se
# configuran en Vercel -> Project Settings -> Environment Variables, o en un
# archivo .env local si usas `vercel dev`. No se incluyen en el bundle del
# navegador porque Vite solo inyecta variables VITE_*.
# =============================================================================

# Clave de la API de Gemini (https://aistudio.google.com/apikey), gratuita.
# Sin esta variable, los endpoints de IA (api/narrativa, api/fases,
# api/ejercicios) responden 503 y el frontend cae automaticamente a su
# contenido local (esta pensado para funcionar igual, solo que sin narrativa
# generada dinamicamente).
GEMINI_API_KEY=

# Modelo de Gemini a usar. Cambialo si tu key no tiene acceso al modelo por
# defecto o si Google libera una version mas nueva.
GEMINI_MODEL=gemini-3.6-flash

# =============================================================================
# Variables de FRONTEND (prefijo VITE_, SI terminan en el bundle del navegador
# — nunca pongas aqui secretos como GEMINI_API_KEY).
# =============================================================================

# Contenido curricular oficial (dbaService.ts / estandaresService.ts).
# NOTA: mineducacion.gov.co/portal/api/dba fue verificado y responde 404 (no existe una API
# publica de DBA hoy). Deja este valor solo si tienes un proxy propio o el MEN publica una API real.
VITE_MEN_DBA_API_URL=https://www.mineducacion.gov.co/portal/api/dba

# Plantilla de URL para scraping de Colombia Aprende, con {grado} como placeholder.
# Sin configurar, el servicio omite esta fuente (no hay IDs de nodo publicos y fallara por CORS).
VITE_COLOMBIA_APRENDE_DBA_URL=

# URLs de los PDFs oficiales de Estandares Basicos de Competencias (verificadas, descargan un PDF valido).
# Un fetch() a estas URLs desde el navegador puede ser bloqueado por CORS en produccion; usa un
# proxy backend propio si necesitas que estas dos fuentes funcionen de forma confiable.
VITE_MEN_ESTANDARES_PDF_URL=https://www.mineducacion.gov.co/1621/articles-340021_recurso_1.pdf
VITE_EDUTEKA_ESTANDARES_PDF_URL=https://eduteka.icesi.edu.co/pdfdir/MENEstandaresMatematicas2003.pdf

# Base URL del backend propio (api/contenido/*, api/narrativa/*, api/fases/*,
# api/ejercicios/*). Vacio = mismo origen (/api), que es lo correcto cuando
# el frontend y las funciones serverless se despliegan juntos en Vercel.
# Solo se necesita si el backend vive en otro dominio.
VITE_API_BASE_URL=

# Timeout de requests HTTP en milisegundos
VITE_API_TIMEOUT=10000

# Habilita datos locales de src/data como fallback cuando la API falla
VITE_ENABLE_LOCAL_FALLBACK=true

# Claves de analitica (utils/analytics.ts)
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_ENABLED=false

# Reporte de Web Vitals en consola durante desarrollo
VITE_REPORT_WEB_VITALS=true

# Nombre y version de la app (usados en el Service Worker / manifest)
VITE_APP_NAME=Aprendiendo con Sentido
VITE_APP_VERSION=0.1.0
